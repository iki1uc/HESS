#HESS-ROOM
NAME: HESS
TYPE: AIR-SCHACH-BATTLE
MODE: C-EXT
STATE: ACTIVE

LOAD:
- core/chess.64
- core/chess.6d
- core/chess.calc
- core/chess.raw

- tmp/board.matrix
- tmp/board.state
- tmp/board.cache

- tmp/moves.anchor
- tmp/moves.points

EXT:
- H/h.room
- SLIDE/slide.room
- COIN.axiom
- score.tmp
- operator.tmp

SPEED³:
IF (moves_in_last_2_seconds >= 3)
THEN SPEED³ = 81
